# The port the Express HTTP server listens on
PORT=5000

# Application runtime environment: development, production, or test
NODE_ENV=development

# MongoDB connection string URI (local or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/pixel_forge

# Dedicated MongoDB connection string URI for running automated tests (separate database)
TEST_MONGODB_URI=mongodb://localhost:27017/pixel_forge_test

# The base URL of the client application allowed by CORS
CLIENT_URL=http://localhost:5173

# Secret used to sign short-lived access JWTs (generate: node -e 'console.log(require("crypto").randomBytes(48).toString("hex"))')
JWT_ACCESS_SECRET=your_jwt_access_secret_must_be_at_least_32_characters_long

# Secret used to sign refresh JWTs (generate: node -e 'console.log(require("crypto").randomBytes(48).toString("hex"))')
JWT_REFRESH_SECRET=your_jwt_refresh_secret_must_be_at_least_32_characters_long

# Lifespan duration string for access tokens (e.g. 15m)
ACCESS_TOKEN_TTL=15m

# Lifespan duration string for refresh tokens (e.g. 7d)
REFRESH_TOKEN_TTL=7d

# Base URL where this server is reachable, used for public file URLs and download links
SERVER_URL=http://localhost:5000

# Directory path (relative to server/) for stored file uploads
UPLOAD_DIR=uploads

# Percentage fee taken by the marketplace platform on each order
PLATFORM_FEE_PERCENT=10
